{
  "code": "code-review",
  "version": "0.0.1",
  "name": "分支 Review",
  "description": "对基准分支和目标分支的真实差异做 Review，输出风险、影响和验证建议。",
  "slogan": "你想 Review 哪次变更？",
  "scenario": "CODE_REVIEW",
  "icon": "icon.svg",
  "color": "#2563eb",
  "promptFile": "prompt.md",
  "enabled": true,
  "resultFormat": "markdown-sections",
  "presentations": [
    "evidence"
  ],
  "queuePriority": 100,
  "capabilities": [
    "project-hub",
    "code-repository",
    "jdbc-readonly-query",
    "wiki-ingest",
    "ask-question"
  ],
  "capabilityConditions": {
    "wiki-ingest": {
      "parameter": "referenceKnowledge",
      "values": [
        "true"
      ]
    }
  },
  "parameters": [
    {
      "key": "referenceKnowledge",
      "name": "参考文档",
      "type": "switch",
      "required": false,
      "description": "开启后可检索并参考当前业务项目的文档证据；关闭时不挂载文档证据读取能力。",
      "defaultValue": "false",
      "sortOrder": 15,
      "visible": true
    },
    {
      "key": "askUserLevel",
      "name": "询问等级",
      "type": "select",
      "required": false,
      "description": "控制 Review 过程中是否允许向用户补充提问；默认关闭，优先通过已有上下文、真实 Git 分支候选和可用证据自行确认。",
      "defaultValue": "OFF",
      "sortOrder": 20,
      "visible": true,
      "options": [
        {
          "label": "关闭",
          "value": "OFF"
        },
        {
          "label": "必要时",
          "value": "NECESSARY"
        },
        {
          "label": "关键确认",
          "value": "CONFIRM"
        }
      ]
    },
    {
      "key": "userInput",
      "name": "补充要求",
      "type": "textarea",
      "required": true,
      "description": "输入重点关注的风险、模块或验证要求",
      "sortOrder": 30,
      "visible": true
    }
  ]
}
